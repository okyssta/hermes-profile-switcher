{
  "name": "hermes-desktop-profile-switcher",
  "version": "1.0.0",
  "private": true,
  "description": "A macOS-style quick switcher for Hermes profiles — Hermes Desktop plugin.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "esbuild src/plugin.tsx --bundle --format=esm --platform=browser --jsx=automatic --external:@hermes/plugin-sdk --external:react --external:react/jsx-runtime --outfile=desktop/plugin.js",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "esbuild": "0.28.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "5.9.2"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
